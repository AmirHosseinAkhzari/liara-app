# Copy to .env and fill in. .env is gitignored.

# Account API token from the Liara Console (a JWT starting with eyJ...).
# Used for PaaS, DBaaS, Object Storage, DNS, Mail, IaaS, Account, Billing and AI management.
LIARA_API_TOKEN=

# Optional: act on a team's resources (sent as ?teamID=...).
LIARA_TEAM_ID=

# AI inference: workspace ID and an AI API key created with POST https://ai.liara.ir/v1/keys
LIARA_AI_WORKSPACE_ID=
LIARA_AI_API_KEY=
